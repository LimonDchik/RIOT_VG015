RAM_START_ADDR ?= 0x40000000
RAM_LEN ?= 256K

ROM_START_ADDR ?= 0x80000000
ROM_LEN ?= 1024K

LINKER_SCRIPT ?= riscv.ld

# Optional external vendor toolchain sysroot.
# Set K1921VG015_TOOLCHAIN_DIR to the root of a full vendor toolchain, e.g.:
#   export K1921VG015_TOOLCHAIN_DIR=/opt/k1921vg015/riscv-gcc
#
# If the variable is not set explicitly, try the conventional per-user install
# location used during local development. The directory is used only as a source
# of matching newlib headers and libraries, while the active compiler still
# comes from the regular RIOT toolchain setup. This keeps toolchain binaries out
# of the repository and avoids hidden dependencies on checked-in artifacts.
ifeq (,$(K1921VG015_TOOLCHAIN_DIR))
  ifneq (,$(wildcard $(HOME)/toolchains/syntacore/sc-dt/riscv-gcc))
    K1921VG015_TOOLCHAIN_DIR := $(HOME)/toolchains/syntacore/sc-dt/riscv-gcc
  endif
endif

ifneq (,$(K1921VG015_TOOLCHAIN_DIR))
  _K1921VG015_TC_INC := $(abspath $(K1921VG015_TOOLCHAIN_DIR))/riscv64-unknown-elf/include
  _K1921VG015_TC_LIB := $(abspath $(K1921VG015_TOOLCHAIN_DIR))/riscv64-unknown-elf/lib/$(CPU_CORE)/ilp32
  _K1921VG015_TC_LIB_COMMON := $(abspath $(K1921VG015_TOOLCHAIN_DIR))/riscv64-unknown-elf/lib

  ifneq (,$(wildcard $(_K1921VG015_TC_INC)/reent.h))
    INCLUDES += -isystem $(_K1921VG015_TC_INC)
  endif
  ifneq (,$(wildcard $(_K1921VG015_TC_LIB)/libc.a))
    LINKFLAGS += -L$(_K1921VG015_TC_LIB)
  endif
  ifneq (,$(wildcard $(_K1921VG015_TC_LIB_COMMON)/libgloss.a))
    LINKFLAGS += -L$(_K1921VG015_TC_LIB_COMMON)
    LINKFLAGS += -lgloss
  endif
endif

CFLAGS += -Wno-error=deprecated-declarations
CXXFLAGS += -Wno-error=deprecated-declarations

include $(RIOTCPU)/riscv_common/Makefile.include
